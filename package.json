{
  "name": "alpha-desktop",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/install-service.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src",
    "preview": "vite preview",
    "desktop:service": "node desktop/service/main.mjs --library-bundle .cache/shared-library",
    "desktop:prepare": "node desktop/prepare.mjs",
    "desktop:build": "tauri build",
    "desktop:dev": "tauri dev",
    "desktop:test": "node --test desktop/service/test/*.test.mjs",
    "desktop:test:ui": "node desktop/service/test/alpha-ui.mjs && node desktop/service/test/cards-ui.mjs",
    "test": "npm run desktop:test",
    "package": "npm run desktop:build -- --bundles nsis",
    "library:build": "node scripts/package-library.mjs",
    "predesktop:service": "npm run library:build"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.4"
  },
  "overrides": {
    "minimatch@>=7.0.0": "^11.0.1"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "description": "Alpha Windows workspace, based on the MrMak desktop workflow.",
  "repository": {
    "type": "git",
    "url": "https://github.com/william-pyle/Alpha.git"
  }
}
